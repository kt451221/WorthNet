-- 1. Absolute Server Anchor (Anti-Fling)
local anchorEnabled = false
RunService.Stepped:Connect(function()
	if not anchorEnabled then return end
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local hrp = char.HumanoidRootPart
		if hrp.AssemblyLinearVelocity.Magnitude > 300 then
			hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end
end)

createModernToggle(Container, "Absolute Anti-Fling", "Seni fırlatmaya çalışanları kendi tuzağına düşürür.", function(state)
	anchorEnabled = state
	showNotification("SwoxTech", "Anti-Fling Durumu: " .. tostring(state), true)
end)

-- 2. Global Aura Expander (Fizik Kalkanı - Herkeste Görünür)
local auraEnabled = false
RunService.Heartbeat:Connect(function()
	if not auraEnabled then return end
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
	
	local myHrp = myChar.HumanoidRootPart
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local targetHrp = p.Character.HumanoidRootPart
			local dist = (myHrp.Position - targetHrp.Position).Magnitude
			if dist < 18 then
				pcall(function()
					targetHrp.AssemblyLinearVelocity = (targetHrp.Position - myHrp.Position).Unit * 450 + Vector3.new(0, 160, 0)
				end)
			end
		end
	end
end)

createModernToggle(Container, "Aura Shield (Fizik Kalkanı)", "Yakınına gelen herkesi herkesin gözü önünde fırlatır.", function(state)
	auraEnabled = state
	showNotification("SwoxTech", "Aura Kalkanı: " .. tostring(state), true)
end)

-- 3. Orbit Locked Pressure (Yörüngeye Alma ve Baskı)
local orbitActive = false
local currentTarget = nil
local orbitAngle = 0

RunService.RenderStepped:Connect(function()
	if not orbitActive or not currentTarget then return end
	local targetChar = currentTarget.Character
	local myChar = LocalPlayer.Character
	
	if targetChar and targetChar:FindFirstChild("HumanoidRootPart") and myChar and myChar:FindFirstChild("HumanoidRootPart") then
		local targetHrp = targetChar.HumanoidRootPart
		local myHrp = myChar.HumanoidRootPart
		
		orbitAngle = orbitAngle + 0.2
		local radius = 6
		local offsetX = math.cos(orbitAngle) * radius
		local offsetZ = math.sin(orbitAngle) * radius
		
		myHrp.CFrame = CFrame.new(targetHrp.Position + Vector3.new(offsetX, 2, offsetZ), targetHrp.Position)
		myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end
end)

-- Otomatik Hileci Avcısı / Hedef Bulucu
RunService.Heartbeat:Connect(function()
	if not orbitActive then return end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = player.Character.HumanoidRootPart
			if hrp.AssemblyLinearVelocity.Magnitude > 120 then
				currentTarget = player
				break
			end
		end
	end
end)

createModernToggle(Container, "Orbit Hunter (Yörünge Baskısı)", "Sana bulaşan hilecinin etrafında dönüp aim'ini bozar.", function(state)
	orbitActive = state
	if state then
		currentTarget = Players:GetPlayers()[2] -- Varsayılan ilk oyuncu
	else
		currentTarget = nil
	end
	showNotification("SwoxTech", "Orbit Baskı: " .. tostring(state), true)
end)

